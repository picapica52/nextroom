# @defaultRequired=true
# @defaultSensitive=false
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @type=enum(development, production, test)
NODE_ENV=development

# @type=port
PORT=8767

# HTTPS, with a self-signed certificate, for phones on the local network: browsers
# give the microphone only to HTTPS pages.
# @type=port
HTTPS_PORT=8768

# Characters, conversations and settings. A relative path is read from the
# working directory, which is apps/server.
DATA_DIR=../../_data

# The built web app to serve. Left empty, only the API is served.
# @optional
WEB_DIST=../web/dist

# The connections, set in .env next to this file. Settings → Connections shows which are set.

# The reply model's endpoint when "OpenAI compatible" is chosen (Ollama, LM Studio, ...).
# @type=url
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1

# Left empty for an endpoint that wants none, such as a local LLM.
# @optional @sensitive
OPENAI_COMPATIBLE_API_KEY=

# The replies set to OpenRouter, and drawing and tagging images.
# @optional @sensitive
OPENROUTER_API_KEY=

# The replies set to Claude, and Claude Agent SDK when it runs with an API key.
# @optional @sensitive
ANTHROPIC_API_KEY=

# The character's web search.
# @optional @sensitive
EXA_API_KEY=

# The character's apps (Gmail, Google Calendar, ...).
# @optional @sensitive
COMPOSIO_API_KEY=

# Speech in and out with ElevenLabs, and the characters' ElevenLabs voices.
# @optional @sensitive
ELEVENLABS_API_KEY=

# The speech.cpp server (`speech serve --open`) for local speech and voice cloning.
# @type=url
SPEECH_URL=http://127.0.0.1:8080
